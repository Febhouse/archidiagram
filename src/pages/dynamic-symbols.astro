---
import LandingLayout from '../layouts/LandingLayout.astro';

const pageTitle = "Dynamic Symbols – SketchUp Plugin for Instant Symbol Animation";
const pageDesc = "Bring your architectural diagrams to life with Dynamic Symbols, a lightweight SketchUp plugin that lets you animate and customize 2D symbols instantly.";
const heroImg = "/images/2025/10/dynamicsymbols.png";
const difyChatUrl = "http://ai.febhouse.com/chat/YKeIjHaYFu5OvVHC";
---

<LandingLayout title={pageTitle} description={pageDesc} heroImage={heroImg} difyChatUrl={difyChatUrl} botName="Dynamic Symbols AI">
	<!-- Hero Section -->
	<header class="text-center max-w-4xl mx-auto mb-16">
		<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-widest uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-5">
			⚡ SKETCHUP EXTENSION
		</div>
		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-6">
			Dynamic Symbols – SketchUp Plugin for Instant Symbol Animation
		</h1>
		<p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 font-light leading-relaxed max-w-3xl mx-auto">
			Bring your architectural diagrams to life with Dynamic Symbols, a lightweight SketchUp plugin that lets you animate and customize 2D symbols instantly.
		</p>
	</header>

	<!-- FEATURES SECTION -->
	<section id="features" class="mb-20">
		<div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">
			<div>
				<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ FEATURES ]</span>
				<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">The Plugin has 03 Core Features.</h2>
			</div>
		</div>

		<div class="space-y-8">
			<!-- Feature 1 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-lg flex flex-col lg:flex-row gap-8 lg:gap-10 items-center transition-all hover:border-amber-500/30">
				<div class="w-full lg:w-1/2 flex-shrink-0 flex items-center justify-center">
					<div class="rounded-lg overflow-hidden border-0 shadow-none flex items-center justify-center">
						<img src="/images/2026/04/Dynamic-symbols-library.gif" alt="One-Click Symbol Change" class="w-full h-auto max-h-[380px] object-contain rounded-lg shadow-none border-0" style="border-radius: 8px !important; box-shadow: none !important; border: none !important;" loading="lazy" />
					</div>
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center">
					<a href="https://youtu.be/VOl67HeTK8M?si=pZwO_7sN0jqGlO-N&t=29" target="_blank" rel="noopener" class="group inline-flex items-center gap-2 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white hover:text-amber-500 dark:hover:text-amber-400 transition-colors mb-3">
						<span>1. One-Click Symbol Change — Keep Position, Size & Rotation</span>
						<svg class="w-5 h-5 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
					</a>
					<p class="text-slate-600 dark:text-slate-300 font-medium mb-3">
						Dynamic Symbols lets you instantly switch between different symbol shapes with just one click — while preserving the symbol’s exact position, size, and rotation in your 3D model.
					</p>
					<ul class="text-sm sm:text-base text-slate-600 dark:text-slate-300 space-y-2 mb-5 list-disc list-inside">
						<li><strong>Step 1:</strong> Select any symbol from the Dynamic Symbols toolbar.</li>
						<li><strong>Step 2:</strong> Click <strong>Yes</strong> when prompted to place the symbol at your cursor.</li>
						<li><strong>Switch Shapes:</strong> To change the symbol type, select it and click any other symbol icon in the toolbar. The geometry updates instantly!</li>
					</ul>
					<div>
						<a href="https://youtu.be/VOl67HeTK8M?si=pZwO_7sN0jqGlO-N&t=29" target="_blank" rel="noopener" class="px-4 py-2 text-xs font-semibold rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold transition-all shadow-sm inline-flex items-center gap-1.5">
							▶️ See How It Works
						</a>
					</div>
				</div>
			</div>

			<!-- Feature 2 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-lg flex flex-col lg:flex-row gap-8 lg:gap-10 items-center transition-all hover:border-amber-500/30">
				<div class="w-full lg:w-1/2 flex-shrink-0 flex items-center justify-center">
					<div class="rounded-lg overflow-hidden border-0 shadow-none flex items-center justify-center">
						<img src="/images/2026/04/Select-color.gif" alt="One-Click Color Change" class="w-full h-auto max-h-[380px] object-contain rounded-lg shadow-none border-0" style="border-radius: 8px !important; box-shadow: none !important; border: none !important;" loading="lazy" />
					</div>
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center">
					<a href="https://youtu.be/VOl67HeTK8M?si=Hoxn73WtmgsATYsa&t=72" target="_blank" rel="noopener" class="group inline-flex items-center gap-2 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white hover:text-amber-500 dark:hover:text-amber-400 transition-colors mb-3">
