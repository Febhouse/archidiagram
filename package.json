{
  "name": "archidiagram-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:archidiagram": "pnpm --filter @apps/archidiagram dev",
    "dev:febhouse": "pnpm --filter @apps/febhouse dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:archidiagram": "pnpm --filter @apps/archidiagram build",
    "build:febhouse": "pnpm --filter @apps/febhouse build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/vite",
      "sharp"
    ]
  },
  "dependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "0.3.2",
    "@bruits/satteri-wasm32-wasi": "0.10.5"
  }
}
