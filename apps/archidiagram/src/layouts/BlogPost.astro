---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
import { isPublishablePost } from '../consts';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string;
	software?: string | string[];
	Software?: string | string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags, software, Software } = Astro.props;

const softwareRaw = software || Software || '';
const softwareList = Array.isArray(softwareRaw) 
	? softwareRaw 
	: (typeof softwareRaw === 'string' && softwareRaw.trim().length > 0)
		? softwareRaw.split(',').map(s => s.trim()).filter(Boolean)
		: [];

function getSoftwareBadge(sw: string) {
	const name = sw.toLowerCase();
	if (name.includes('sketchup')) {
		return { label: sw, logo: '/images/LOGO/SketchUp-logo.svg', class: 'bg-red-500/10 text-red-700 dark:text-red-300 border-red-500/20' };
	} else if (name.includes('sun diagram')) {
		return { label: sw, logo: '/images/LOGO/SunDiagram-logo.svg?v=2', class: 'bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-500/20', url: '/sun-diagram/' };
	} else if (name.includes('dynamic symbols')) {
		return { label: sw, logo: '/images/LOGO/dynamic-symbols-logo.svg', class: 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/20', url: '/dynamic-symbols/' };
	} else if (name.includes('shadow slice')) {
		return { label: sw, logo: '/images/LOGO/Shadowslice-logo.svg', class: 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border-cyan-500/20', url: '/shadow-slice/' };
	} else if (name.includes('photoshop')) {
		return { label: sw, logo: '/images/LOGO/Adobe_Photoshop_CC_icon.svg', class: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20' };
	} else if (name.includes('canva')) {
		return { label: sw, logo: '/images/LOGO/canva-icon.svg', class: 'bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/20' };
	} else if (name.includes('powerpoint')) {
		return { label: sw, logo: '/images/LOGO/Microsoft_Office_PowerPoint_(2025–present).svg', class: 'bg-orange-500/10 text-orange-700 dark:text-orange-300 border-orange-500/20' };
	} else if (name.includes('indesign')) {
		return { label: sw, logo: '/images/LOGO/Adobe_InDesign_CC_icon.svg', class: 'bg-pink-500/10 text-pink-700 dark:text-pink-300 border-pink-500/20' };
	} else if (name.includes('rwind')) {
		return { label: sw, logo: '/images/LOGO/Rwind-logo.svg', class: 'bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/20' };
	} else if (name.includes('gemini')) {
		return { label: sw, logo: '/images/LOGO/Gemini_logo_2025.svg', class: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20' };
	}
	return { label: sw, logo: null, class: 'bg-slate-500/10 text-slate-700 dark:text-slate-300 border-slate-500/20' };
}

// Determine clean tag label
let tagLabel = "TUTORIAL & TIPS";
const tagRaw = Array.isArray(tags) ? tags.join(' ') : (tags || '');
const tagStr = tagRaw.toLowerCase();
if (tagStr.includes("sample project") || tagStr.includes("sample")) {
	tagLabel = "SAMPLE PROJECTS";
} else if (tagStr.includes("presentation template") || tagStr.includes("template")) {
	tagLabel = "PRESENTATION & SITE ANALYSIS TEMPLATES";
} else if (tagStr.includes("other resources") || tagStr.includes("extension")) {
	tagLabel = "SKETCHUP EXTENSIONS";
}

// Fetch related posts (3 posts with matching tags, fallback to latest)
const allPosts = (await getCollection('blog')).filter(isPublishablePost);
const currentTag = tagStr.trim();

let relatedPosts = allPosts.filter(p => {
	if (p.data.title === title) return false;
	const pRaw = Array.isArray(p.data.tags) ? p.data.tags.join(' ') : (p.data.tags || '');
	const pTag = pRaw.trim().toLowerCase();
	if (!currentTag || currentTag === 'all') return true;
	return pTag === currentTag || pTag.includes(currentTag) || currentTag.includes(pTag);
});

if (relatedPosts.length < 3) {
	const fallbackPosts = allPosts.filter(p => p.data.title !== title && !relatedPosts.some(r => r.id === p.id));
	relatedPosts = [...relatedPosts, ...fallbackPosts];
}

relatedPosts = relatedPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// Prepare JSON-LD Schema
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description || title,
  "image": heroImage ? new URL(heroImage, Astro.site).toString() : '',
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate || pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": "Nam Nguyen",
    "url": "https://archidiagram.com"
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`${title} - Archi Diagram`} description={description || title} image={heroImage} />
		<style is:global>
			/* Prevent emojis or inline SVGs from expanding to full container width */
			.article-content img[src*="emoji"],
			.article-content img[src*="svg"],
			.article-content img[alt*="👉"],
			.article-content img[alt*="⚡"],
			.article-content img[alt*="⭐"] {
				max-width: 28px !important;
				max-height: 28px !important;
				width: auto !important;
				display: inline-block !important;
				margin: 0 4px !important;
				vertical-align: -0.2em !important;
				box-shadow: none !important;
				border: none !important;
				background: transparent !important;
			}
		</style>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-amber-500/20 selection:text-amber-700 transition-colors duration-300">
		<Header />

		<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
