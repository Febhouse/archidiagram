---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
import { isPublishablePost } from '../consts';

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string;
	software?: string | string[];
	Software?: string | string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags, software, Software } = Astro.props;

const softwareRaw = software || Software || '';
const softwareList = Array.isArray(softwareRaw) 
	? softwareRaw 
	: (typeof softwareRaw === 'string' && softwareRaw.trim().length > 0)
		? softwareRaw.split(',').map(s => s.trim()).filter(Boolean)
		: [];

function getSoftwareBadge(sw: string) {
	const name = sw.toLowerCase();
	if (name.includes('sketchup')) {
		return { label: sw, logo: '/images/LOGO/SketchUp-logo.svg', class: 'bg-red-500/10 text-red-700 dark:text-red-300 border-red-500/20' };
	} else if (name.includes('sun diagram')) {
		return { label: sw, logo: '/images/LOGO/SunDiagram-logo.svg', class: 'bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-500/20' };
	} else if (name.includes('dynamic symbols')) {
		return { label: sw, logo: '/images/LOGO/dynamic-symbols-logo.svg', class: 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/20' };
	} else if (name.includes('shadow slice')) {
		return { label: sw, logo: '/images/LOGO/Shadowslice-logo.svg', class: 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border-cyan-500/20' };
	} else if (name.includes('photoshop')) {
		return { label: sw, logo: '/images/LOGO/Adobe_Photoshop_CC_icon.svg', class: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20' };
	} else if (name.includes('canva')) {
		return { label: sw, logo: '/images/LOGO/canva-icon.svg', class: 'bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/20' };
	} else if (name.includes('powerpoint')) {
		return { label: sw, logo: '/images/LOGO/Microsoft_Office_PowerPoint_(2025–present).svg', class: 'bg-orange-500/10 text-orange-700 dark:text-orange-300 border-orange-500/20' };
	} else if (name.includes('indesign')) {
		return { label: sw, logo: '/images/LOGO/Adobe_InDesign_CC_icon.svg', class: 'bg-pink-500/10 text-pink-700 dark:text-pink-300 border-pink-500/20' };
	} else if (name.includes('rwind')) {
		return { label: sw, logo: '/images/LOGO/Rwind-logo.svg', class: 'bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/20' };
	} else if (name.includes('gemini')) {
		return { label: sw, logo: '/images/LOGO/Gemini_logo_2025.svg', class: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20' };
	}
	return { label: sw, logo: null, class: 'bg-slate-500/10 text-slate-700 dark:text-slate-300 border-slate-500/20' };
}

// Determine clean tag label
let tagLabel = "TUTORIAL & TIPS";
const tagRaw = Array.isArray(tags) ? tags.join(' ') : (tags || '');
const tagStr = tagRaw.toLowerCase();
if (tagStr.includes("sample project") || tagStr.includes("sample")) {
	tagLabel = "SAMPLE PROJECTS";
} else if (tagStr.includes("presentation template") || tagStr.includes("template")) {
	tagLabel = "PRESENTATION & SITE ANALYSIS TEMPLATES";
} else if (tagStr.includes("other resources") || tagStr.includes("extension")) {
	tagLabel = "SKETCHUP EXTENSIONS";
}

// Fetch related posts (3 posts with matching tags, fallback to latest)
const allPosts = (await getCollection('blog')).filter(isPublishablePost);
const currentTag = tagStr.trim();

let relatedPosts = allPosts.filter(p => {
	if (p.data.title === title) return false;
	const pRaw = Array.isArray(p.data.tags) ? p.data.tags.join(' ') : (p.data.tags || '');
	const pTag = pRaw.trim().toLowerCase();
	if (!currentTag || currentTag === 'all') return true;
	return pTag === currentTag || pTag.includes(currentTag) || currentTag.includes(pTag);
});

if (relatedPosts.length < 3) {
	const fallbackPosts = allPosts.filter(p => p.data.title !== title && !relatedPosts.some(r => r.id === p.id));
	relatedPosts = [...relatedPosts, ...fallbackPosts];
}

relatedPosts = relatedPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`${title} - Archi Diagram`} description={description || title} />
		<style is:global>
			/* Prevent emojis or inline SVGs from expanding to full container width */
			.article-content img[src*="emoji"],
			.article-content img[src*="svg"],
			.article-content img[alt*="👉"],
			.article-content img[alt*="⚡"],
			.article-content img[alt*="⭐"] {
				max-width: 28px !important;
				max-height: 28px !important;
				width: auto !important;
				display: inline-block !important;
				margin: 0 4px !important;
				vertical-align: -0.2em !important;
				box-shadow: none !important;
				border: none !important;
				background: transparent !important;
			}
		</style>
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-amber-500/20 selection:text-amber-700 transition-colors duration-300">
		<Header />

		<main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
			<article class="w-full">
				<!-- Article Header (Aligned with Body Edges) -->
				<header class="w-full mb-10 text-center sm:text-left">
					<div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mb-4 text-xs font-mono font-semibold">
						<span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-400 border border-amber-500/20 uppercase tracking-wider">
							{tagLabel}
						</span>
						<span class="text-slate-400 dark:text-slate-500">•</span>
						<div class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
							</svg>
							<FormattedDate date={pubDate} />
						</div>
					</div>

					<h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
						{title}
					</h1>

					{description && (
						<p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 font-normal leading-relaxed mb-6">
							{description}
						</p>
					)}

					{softwareList.length > 0 && (
						<div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-6 pt-1">
							<span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mr-1">
								Software Used:
							</span>
							{softwareList.map(sw => {
								const badge = getSoftwareBadge(sw);
								return (
									<span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-mono font-bold border ${badge.class}`}>
										{badge.logo && (
											<img src={badge.logo} alt={badge.label} class="w-4 h-4 shrink-0 object-contain" />
										)}
										<span>{badge.label}</span>
									</span>
								);
							})}
						</div>
					)}
				</header>

				<!-- Article Body Content (Full width matching header edges) -->
				<div class="w-full bg-white dark:bg-slate-900 p-6 sm:p-10 lg:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm article-content flow-root" id="article-body">
					<slot />
				</div>

				<!-- Author Bio Section (Refined Editorial Style matching original site) -->
				<div class="w-full mt-14 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center sm:items-start gap-5 clear-both">
					<img 
						src="/images/author-nam-nguyen.jpg" 
						alt="Nam Nguyen" 
						class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover shrink-0 border border-slate-200 dark:border-slate-700 shadow-sm author-avatar"
						style="border-radius: 9999px !important;"
						onerror="this.onerror=null; this.src='/images/2025/03/cropped-FEBHOUSE-LOGO600x600.png';"
					/>
					<div class="space-y-1.5 text-center sm:text-left flex-grow">
						<p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
							About The Author
						</p>
						<h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug">
							Nam Nguyen
						</h3>
						<p class="text-xs sm:text-sm italic text-slate-600 dark:text-slate-400">
							Architect & Software Developer | Founder of Febhouse & ArchiDiagram
						</p>
						<p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed pt-1">
							I build tools like <a href="/sun-diagram/" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Sun Diagram</a>, <a href="/dynamic-symbols/" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Dynamic Symbols</a>, and <a href="/shadow-slice/" class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">Shadow Slice</a> to help architects work smarter.
						</p>
						<div class="text-xs text-slate-500 dark:text-slate-400 font-medium flex flex-wrap items-center justify-center sm:justify-start gap-1.5 pt-1">
							<span class="font-bold text-slate-700 dark:text-slate-300">Connect:</span>
							<a href="https://instagram.com/febhouse_com" target="_blank" rel="noopener" class="text-amber-600 dark:text-amber-400 hover:underline">Instagram</a>
							<span>|</span>
							<a href="https://tiktok.com/@febhouse" target="_blank" rel="noopener" class="text-amber-600 dark:text-amber-400 hover:underline">TikTok</a>
							<span>|</span>
							<a href="https://www.linkedin.com/in/nguyenhanam/" target="_blank" rel="noopener" class="text-amber-600 dark:text-amber-400 hover:underline">LinkedIn</a>
							<span>|</span>
							<a href="https://youtube.com/@febhouse" target="_blank" rel="noopener" class="text-amber-600 dark:text-amber-400 hover:underline">YouTube</a>
						</div>
					</div>
				</div>

				<!-- 📚 RELATED POSTS SECTION (3-5 cards with matching tags) -->
				{relatedPosts.length > 0 && (
					<div class="w-full mt-14 pt-10 border-t border-slate-200 dark:border-slate-800 clear-both">
						<div class="mb-8 text-center sm:text-left">
							<span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-amber-500/10 text-amber-800 dark:text-amber-400 border border-amber-500/20 mb-2">
								RELATED RESOURCES
							</span>
							<h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
								More in {tagLabel}
							</h3>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
							{relatedPosts.map((post) => (
								<Card 
									id={post.id}
									title={post.data.title}
									description={post.data.description}
									pubDate={post.data.pubDate}
									heroImage={post.data.heroImage}
									tags={post.data.tags}
									software={post.data.software || (post.data as any).Software}
								/>
							))}
						</div>
					</div>
				)}

				<!-- Navigation Back to All Resources Button -->
				<div class="w-full mt-12 text-center clear-both">
					<a href="/#resources" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs sm:text-sm hover:bg-amber-500 dark:hover:bg-amber-400 dark:hover:text-slate-950 transition-all shadow-md">
						← Back to All Tutorials & Resources
					</a>
				</div>
			</article>
		</main>

		<Footer />

		<!-- Custom JavaScript for article link enhancements & video embeds -->
		<script is:inline>
			(function() {
				function enhanceArticleContent() {
					const article = document.getElementById('article-body');
					if (!article) return;

					const ytRegex = /(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:shorts\/|watch\?(?:.*&)?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/i;

					function extractStartTime(url) {
						try {
							// Handle raw text urls that might lack protocol
							const fullUrl = url.startsWith('http') ? url : 'https://' + url;
							const urlObj = new URL(fullUrl);
							let t = urlObj.searchParams.get('t') || urlObj.searchParams.get('start');
							if (!t) return '';
							
							let seconds = 0;
							if (typeof t === 'string' && t.match(/[hms]/)) {
								const hMatch = t.match(/(\d+)h/);
								const mMatch = t.match(/(\d+)m/);
								const sMatch = t.match(/(\d+)s/);
								if (hMatch) seconds += parseInt(hMatch[1], 10) * 3600;
								if (mMatch) seconds += parseInt(mMatch[1], 10) * 60;
								if (sMatch) seconds += parseInt(sMatch[1], 10);
							} else {
								seconds = parseInt(t, 10) || 0;
							}
							return seconds > 0 ? `&start=${seconds}` : '';
						} catch (e) {
							return '';
						}
					}

					function handleYouTubeEmbed(targetEl, videoId, isShort, startTimeParam) {
						const parentP = targetEl.tagName === 'P' ? targetEl : targetEl.closest('p');
						const elementToReplace = parentP || targetEl;

						if (isShort) {
							// Find nearest preceding heading to anchor the floated video right at the start of the section
							let prev = elementToReplace.previousElementSibling;
							let nearestHeading = null;
							while (prev) {
								const tag = prev.tagName ? prev.tagName.toUpperCase() : '';
								if (tag.startsWith('H') && tag !== 'HR') {
									nearestHeading = prev;
									break;
								}
								prev = prev.previousElementSibling;
							}

							const floatWrapper = document.createElement('div');
							floatWrapper.className = 'video-shorts-float';
							floatWrapper.innerHTML = `<div class="video-shorts-wrapper"><iframe src="https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1${startTimeParam}" title="YouTube Shorts" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe></div>`;

							if (nearestHeading && nearestHeading.parentNode) {
								nearestHeading.after(floatWrapper);
								elementToReplace.remove();
							} else {
								elementToReplace.replaceWith(floatWrapper);
							}
						} else {
							// Standard 16:9 horizontal video (100% full width aligned with container edges)
							const wrapper = document.createElement('div');
							wrapper.className = 'video-standard-wrapper';
							wrapper.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1${startTimeParam}" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>`;
							elementToReplace.replaceWith(wrapper);
						}
					}

					// 1. Convert YouTube URLs in links
					const links = Array.from(article.querySelectorAll('a'));
					for (const link of links) {
						if (!link.isConnected) continue;
						const href = link.getAttribute('href') || '';
						const ytMatch = href.match(ytRegex);
						if (ytMatch) {
							// Exclude small inline action buttons like "See How It Works" in feature cards
							if (link.classList.contains('inline-flex') && link.closest('.flex-wrap')) {
								continue;
							}

							const videoId = ytMatch[1];
							const isShort = href.includes('/shorts/') || link.innerText.toLowerCase().includes('short');
							const startTimeParam = extractStartTime(href);
							handleYouTubeEmbed(link, videoId, isShort, startTimeParam);
						}
					}

					// 2. Also check any paragraphs with raw unlinked YouTube URLs
					const paragraphs = Array.from(article.querySelectorAll('p'));
					for (const p of paragraphs) {
						if (!p.isConnected || p.querySelector('iframe')) continue;
						const text = p.innerHTML;
						const rawMatch = text.match(ytRegex);
						if (rawMatch) {
							const videoId = rawMatch[1];
							const isShort = text.includes('/shorts/');
							
							// Find the exact matched URL substring to extract parameters
							const matchedUrl = text.match(/https?:\/\/[^\s<]+/);
							const startTimeParam = matchedUrl ? extractStartTime(matchedUrl[0]) : '';
							
							handleYouTubeEmbed(p, videoId, isShort, startTimeParam);
						}
					}

					// 3. Transform download links into download buttons with clean line-break wrapping
					const downloadSvg = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;

					const allLinks = Array.from(article.querySelectorAll('a'));
					for (const link of allLinks) {
						if (!link.isConnected) continue;
						const href = (link.getAttribute('href') || '').toLowerCase();
						const text = (link.textContent || '').trim();
						const textLower = text.toLowerCase();

						const isDownloadDomain = href.includes('drive.google.com') ||
												 href.includes('gumroad.com') ||
												 href.includes('ko-fi.com') ||
												 href.includes('dropbox.com') ||
												 href.includes('mega.nz') ||
												 href.includes('mediafire.com');

						const isDownloadText = textLower.includes('download') ||
											   textLower.includes('tải về') ||
											   textLower.includes('tải file') ||
											   textLower.includes('link to template') ||
											   textLower.includes('preview file') ||
											   textLower.includes('free file');

						if (isDownloadDomain || (isDownloadText && (href.startsWith('http') || href.startsWith('/')))) {
							if (link.classList.contains('download-btn') || textLower.includes('back to all') || textLower.includes('plugin page') || link.closest('.flex-wrap.gap-3')) {
								continue;
							}

							link.classList.add('download-btn');
							link.setAttribute('target', '_blank');
							link.setAttribute('rel', 'noopener noreferrer');

							let cleanLabel = text.replace(/^\[\s*|\s*\]$/g, '').trim();
							if (!cleanLabel) {
								cleanLabel = 'Free Download';
							}

							if (!link.querySelector('svg')) {
								link.innerHTML = `${downloadSvg}<span>${cleanLabel}</span>`;
							}

							const parentP = link.closest('p');
							if (parentP) {
								parentP.classList.add('download-btn-wrapper');
								Array.from(parentP.childNodes).forEach(node => {
									if (node.nodeType === Node.TEXT_NODE) {
										const val = (node.textContent || '').trim().toLowerCase();
										if (val === 'and' || val === 'or' || val === 'và' || val === 'hoặc') {
											node.remove();
										}
									}
								});
							}
						}
					}

					// 4. Ensure article body container completely clears and wraps all floated elements
					if (!article.querySelector('.article-clear-bottom')) {
						const clearDiv = document.createElement('div');
						clearDiv.className = 'article-clear-bottom clear-both w-full h-0 block';
						article.appendChild(clearDiv);
					}
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', enhanceArticleContent);
				} else {
					enhanceArticleContent();
				}
			})();
		</script>
	</body>
</html>
