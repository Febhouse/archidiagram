---
import LandingLayout from '../layouts/LandingLayout.astro';
import { Content, frontmatter } from './_about.md';
---

<LandingLayout
	title={frontmatter.title}
	description={frontmatter.description}
	heroImage={frontmatter.heroImage}
>
	<div class="max-w-3xl mx-auto w-full">
		<article class="bg-white dark:bg-slate-900 p-6 sm:p-10 lg:p-12 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm article-content flow-root">
			<Content />
		</article>
	</div>
</LandingLayout>
