---
import LandingLayout from '../layouts/LandingLayout.astro';

const pageTitle = "Sun Diagram – 3D Sun Path & Solar Analysis Plugin for SketchUp";
const pageDesc = "Create scientifically accurate 3D Sun paths, real-time shadow simulations, and 4K batch shadow exports directly in SketchUp.";
const heroImg = "/images/2025/10/febhouse.png";
const difyChatUrl = "https://ai.febhouse.com/chat/C0Q1A6qmSoCpESHQ";
