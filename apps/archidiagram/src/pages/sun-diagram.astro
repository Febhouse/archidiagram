						<svg class="w-5 h-5 text-slate-400 transition-transform duration-300 accordion-chevron flex-shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
					</summary>
					<div class="p-5 pt-0 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
