---
import LandingLayout from "../layouts/LandingLayout.astro";
import TrustSignals from "../components/TrustSignals.astro";

const pageTitle =
	"Sun Diagram – 3D Sun Path & Solar Analysis Plugin for SketchUp";
const pageDesc =
	"Create scientifically accurate 3D Sun paths, real-time shadow simulations, and 4K batch shadow exports directly in SketchUp.";
const heroImg = "/images/2025/10/febhouse.webp";
const difyChatUrl = "https://ai.febhouse.com/chat/WzxqYtwxpWEYecSx";
---

<LandingLayout
	title={pageTitle}
	description={pageDesc}
	heroImage={heroImg}
	difyChatUrl={difyChatUrl}
	botName="Sun Diagram AI"
>
	<!-- Hero Section -->
	<header class="text-center max-w-4xl mx-auto mb-16">
		<div
			class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-widest uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-5"
		>
			⚡ SKETCHUP EXTENSION
		</div>
		<h1
			class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-6"
		>
			Sun Diagram is an extension for creating 3D sun paths and analyzing
			sunlight in architectural projects.
		</h1>
		<p
			class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-8"
		>
			Accurate solar simulation, real-time interactive shadow studies,
			daylight saving time calculations, and one-click batch animation
			exports for SketchUp 2020–2026.
		</p>

		<div class="flex flex-col items-center justify-center gap-8 mt-10">
			<!-- Trust Badge (Logo + Stars) -->
			<div class="flex items-center gap-4 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 p-4 pr-6 rounded-2xl shadow-sm backdrop-blur-md">
				<img src="/images/LOGO/SunDiagram-logo.svg?v=2" alt="Sun Diagram Logo" class="w-14 h-14 object-contain drop-shadow-sm" />
				<div class="flex flex-col items-start border-l border-slate-300 dark:border-slate-700 pl-4">
					<a href="https://extensions.sketchup.com/search/?q=febhouse" target="_blank" rel="noopener" class="flex items-center gap-1 text-amber-500 text-lg mb-0.5 tracking-tighter hover:scale-105 transition-transform cursor-pointer" aria-label="5 stars">
						★★★★★
					</a>
					<div class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-0.5 leading-snug text-left">
						Trusted by <strong class="text-slate-900 dark:text-white text-sm">38,000+</strong> users<br/>
						<a href="https://extensions.sketchup.com/search/?q=febhouse" target="_blank" rel="noopener" class="text-amber-600 dark:text-amber-400 hover:underline inline-flex items-center gap-0.5 mt-0.5">
							Verified SketchUp Developer ✓
						</a>
					</div>
				</div>
			</div>

			<!-- Main CTA Button -->
			<a
				href="#download"
				class="px-8 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm sm:text-base shadow-lg shadow-amber-500/20 hover:shadow-xl hover:shadow-amber-500/30 transition-all transform hover:-translate-y-1 flex items-center gap-2"
			>
				<span>Get Sun Diagram</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-bounce" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v10.586l3.293-3.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-5-5a1 1 0 111.414-1.414L9 14.586V4a1 1 0 011-1z" clip-rule="evenodd" />
				</svg>
			</a>
		</div>
	</header>

	<!-- FEATURES SECTION -->
	<section id="features" class="mb-20">
		<div
			class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 mb-8"
		>
			<div>
				<span
					class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase"
					>[ FEATURES ]</span
				>
				<h2
					class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1"
				>
					The plugin has 04 core features.
				</h2>
			</div>
		</div>

		<div class="space-y-8">
			<!-- Feature 1 -->
			<div
				class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[8px] p-[10px] shadow-sm flex flex-col lg:flex-row gap-6 lg:gap-8 items-start transition-all hover:border-amber-500/30"
			>
				<div class="w-full lg:w-1/2 flex-shrink-0">
					<img
						src="/images/2026/06/1F.gif"
						width="1024" height="576"
						alt="Create Sun path diagram"
						class="w-full h-auto rounded-[8px] object-cover shadow-none border-none block"
						loading="lazy" decoding="async"
					/>
				</div>
				<div
					class="w-full lg:w-1/2 flex flex-col justify-center p-2 sm:p-4"
				>
					<h3 class="mb-3">
						<a
							href="https://youtu.be/hMH1T1M9wic?si=aGubLEJYJBnTxyVd&t=20"
							target="_blank"
							rel="noopener"
							class="group inline-flex items-center gap-2 text-xl sm:text-2xl font-bold text-slate-900 dark:text-white hover:text-amber-500 dark:hover:text-amber-400 transition-colors"
						>
							<span>1. Create Sunpath (Feature 1)</span>
							<svg
								class="w-5 h-5 text-slate-400 group-hover:translate-x-1 transition-transform"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
							>
						</a>
					</h3>
					<p
						class="text-slate-600 dark:text-slate-300 font-medium mb-3"
					>
						<strong
							>Generate a 3D Sunpath by entering your project’s
							location.</strong
						> Choose input methods:
					</p>
					<ul
						class="text-sm sm:text-base text-slate-600 dark:text-slate-300 space-y-2 mb-4 list-disc list-inside"
					>
						<li>
							<strong>Option A – From Model:</strong> Use the coordinates
							already embedded in your SketchUp model (via <em
								>File -> Add Location</em
							>).
						</li>
						<li>
							<strong>Option B – Manual Input:</strong> Enter latitude
							and longitude directly. Coordinates can be copied from
							Google Maps (format example: <code
								>26.2649, -81.6255</code
							>).
						</li>
					</ul>
					<div
						class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-800 dark:text-amber-300 text-sm font-medium mb-4 flex items-start gap-2.5"
					>
						<span class="text-base">⭐</span>
						<div>
							<strong>Smart DST Engine:</strong> Enable Daylight Saving
							Time (DST) for highly accurate solar analysis in regions
							with seasonal time changes (Premium Feature).
						</div>
					</div>
					<div class="flex flex-wrap gap-3">
						<a
							href="/daylight-saving-time/"
							class="px-4 py-2 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
						>
							Why is the DST feature important?
						</a>
						<a
							href="https://youtu.be/hMH1T1M9wic?si=aGubLEJYJBnTxyVd&t=20"
							target="_blank"
							rel="noopener"
							class="px-4 py-2 text-xs font-semibold rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold transition-all shadow-sm flex items-center gap-1.5"
						>
							▶️ See How It Works
						</a>
					</div>
				</div>
			</div>

			<!-- Feature 2 -->
