---
import LandingLayout from '../layouts/LandingLayout.astro';
import TrustSignals from '../components/TrustSignals.astro';

const pageTitle = "Shadow Slice: Interior Shadow & Section Tool For SketchUp";
const pageDesc = "Cut away walls and roofs while keeping their natural shadows. The essential tool for interior sunlight simulation and perspective section diagrams.";
const heroImg = "/images/2026/01/Shadow_Slice_1024.webp";
---

<LandingLayout title={pageTitle} description={pageDesc} heroImage={heroImg}>
	<!-- Hero Section -->
	<header class="text-center max-w-4xl mx-auto mb-16">
		<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-widest uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-5">
			⚡ SKETCHUP EXTENSION
		</div>
		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-6">
			Shadow Slice – Interior Shadow & Section Tool For SketchUp
		</h1>
		<p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-8">
			Cut away walls and roofs while keeping their natural shadows. The essential tool for interior sunlight simulation and perspective section diagrams.
		</p>

		<div class="flex flex-col items-center justify-center gap-8 mt-10">
			<!-- Trust Badge (Logo + Stars) -->
			<div class="flex items-center gap-4 bg-white/60 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 p-4 pr-6 rounded-2xl shadow-sm backdrop-blur-md">
				<img src="/images/LOGO/Shadowslice-logo.svg" alt="Shadow Slice Logo" class="w-14 h-14 object-contain drop-shadow-sm" />
				<div class="flex flex-col items-start border-l border-slate-300 dark:border-slate-700 pl-4">
					<a href="https://extensions.sketchup.com/search/?q=febhouse" target="_blank" rel="noopener" class="flex items-center gap-1 text-amber-500 text-lg mb-0.5 tracking-tighter hover:scale-105 transition-transform cursor-pointer" aria-label="5 stars">
						★★★★★
					</a>
					<div class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-0.5 leading-snug text-left">
						Trusted by <strong class="text-slate-900 dark:text-white text-sm">1,700+</strong> users<br/>
						<a href="https://extensions.sketchup.com/search/?q=febhouse" target="_blank" rel="noopener" class="text-amber-600 dark:text-amber-400 hover:underline inline-flex items-center gap-0.5 mt-0.5">
							Verified SketchUp Developer ✓
						</a>
					</div>
				</div>
			</div>

			<!-- Main CTA Button -->
			<a
				href="#download"
				class="px-8 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm sm:text-base shadow-lg shadow-amber-500/20 hover:shadow-xl hover:shadow-amber-500/30 transition-all transform hover:-translate-y-1 flex items-center gap-2"
			>
				<span>Get Shadow Slice</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 animate-bounce" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v10.586l3.293-3.293a1 1 0 111.414 1.414l-5 5a1 1 0 01-1.414 0l-5-5a1 1 0 111.414-1.414L9 14.586V4a1 1 0 011-1z" clip-rule="evenodd" />
				</svg>
			</a>
		</div>
	</header>

	<!-- FEATURES SECTION -->
	<section id="features" class="mb-24">
		<div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">
			<div>
				<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ FEATURES ]</span>
				<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">The Plugin has 03 Core Features.</h2>
			</div>
		</div>

		<div class="space-y-8">
			<!-- Feature 1 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[8px] p-[10px] shadow-sm flex flex-col lg:flex-row gap-6 lg:gap-8 items-start transition-all hover:border-amber-500/30">
				<div class="w-full lg:w-1/2 flex-shrink-0">
					<img src="/images/2026/06/Feature02.gif" width="853" height="480" alt="1-Click Interactive Slicing" class="w-full h-auto rounded-[8px] object-cover" loading="lazy" decoding="async" />
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center p-2 sm:p-4">
					<h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-3">
						1. 1-Click Interactive Slicing
					</h3>
					<p class="text-slate-600 dark:text-slate-300 font-medium mb-4 leading-relaxed">
						Forget tedious manual section setups or deleting roofs. Simply click the <strong>+ Add Slice Tool</strong> on the Shadow Slice dashboard, click directly on the Group or Component you want to cut, and you're done!
					</p>
					<ul class="text-sm sm:text-base text-slate-600 dark:text-slate-300 space-y-2 list-disc list-inside">
						<li>Non-destructive slicing that keeps your original 3D geometry intact.</li>
						<li>Shadows from sliced walls and roofs continue casting physically accurate shadows inside.</li>
					</ul>
				</div>
			</div>

			<!-- Feature 2 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[8px] p-[10px] shadow-sm flex flex-col lg:flex-row gap-6 lg:gap-8 items-start transition-all hover:border-amber-500/30">
				<div class="w-full lg:w-1/2 flex-shrink-0">
					<img src="/images/2026/06/Feature1-1.gif" width="853" height="480" alt="Centralized Dashboard" class="w-full h-auto rounded-[8px] object-cover" loading="lazy" decoding="async" />
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center p-2 sm:p-4">
					<h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-3">
						2. Centralized Visual Dashboard
					</h3>
					<p class="text-slate-600 dark:text-slate-300 font-medium mb-4 leading-relaxed">
						All your active Shadow Slices are managed visually inside a single, intuitive control panel. Instantly toggle visibility, adjust slice positions, or customize section fill colors on the fly.
					</p>
					<ul class="text-sm sm:text-base text-slate-600 dark:text-slate-300 space-y-2 list-disc list-inside">
						<li>Manage multiple slice planes simultaneously with independent toggles.</li>
						<li>Customizable slice line weights, edge styles, and cross-section fill colors.</li>
					</ul>
				</div>
			</div>

			<!-- Feature 3 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[8px] p-[10px] shadow-sm flex flex-col lg:flex-row gap-6 lg:gap-8 items-start transition-all hover:border-amber-500/30">
				<div class="w-full lg:w-1/2 flex-shrink-0">
					<img src="/images/2026/06/Feature03.gif" width="853" height="480" alt="Smart Style Management" class="w-full h-auto rounded-[8px] object-cover" loading="lazy" decoding="async" />
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center p-2 sm:p-4">
					<h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-3">
						3. Smart Style Management
					</h3>
					<p class="text-slate-600 dark:text-slate-300 font-medium mb-4 leading-relaxed">
						Shadow Slice automates the background style configurations, layer management, and shadow settings, letting you focus 100% on your design concepts without breaking exterior lighting.
					</p>
					<ul class="text-sm sm:text-base text-slate-600 dark:text-slate-300 space-y-2 list-disc list-inside">
						<li>One-click activation of architectural diagram styles.</li>
						<li>Automatic scene creation for sequential solar presentations.</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

