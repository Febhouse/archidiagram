							Create stunning 3D perspective sections that communicate spatial flow and interior massing without losing environmental context.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

		<!-- USER GUIDE DOWNLOAD SECTION -->
	<section class="mb-20">
		<div class="text-center">
			<a
				href="https://assets.archidiagram.com/UserGuide/ShadowSlice_UserGuide.pdf"
