---
import LandingLayout from '../layouts/LandingLayout.astro';

const pageTitle = "Custom Architectural Diagram & Site Analysis Service";
const pageDesc = "Professional solar and site analysis service to help you validate design impacts with precision, factual data, and presentation clarity.";
const heroImg = "/images/2026/01/SAMPLE-57cover.jpg";
---

<LandingLayout title={pageTitle} description={pageDesc} heroImage={heroImg}>
	<!-- Hero Section -->
	<header class="text-center max-w-4xl mx-auto mb-16">
		<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-widest uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-5">
			📐 PROFESSIONAL SERVICE
		</div>
		<h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-6">
			Custom Architectural Diagram & Site Analysis Service
		</h1>
		<p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-8">
			Professional solar and site analysis service to help you validate design impacts with precision, factual data, and presentation clarity.
		</p>
		<a href="https://www.fiverr.com/febhouse_com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-base shadow-xl shadow-amber-500/20 transition-all hover:scale-[1.02] active:scale-[0.98]">
			👉 Discuss Your Project on Fiverr
		</a>
	</header>

	<!-- WHO THIS SERVICE IS FOR -->
	<section class="mb-24">
		<div class="border-b border-slate-200 dark:border-slate-800 pb-3 mb-8">
			<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ TARGET AUDIENCE ]</span>
			<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Who This Service Is For</h2>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
				<div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl mb-4 font-bold">🏛️</div>
				<h3 class="font-bold text-slate-900 dark:text-white mb-2">Architects & Studios</h3>
				<p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
					Real-world project site analysis, solar validation, and council approval diagrams ready for presentation.
				</p>
			</div>

			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
				<div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl mb-4 font-bold">⚙️</div>
				<h3 class="font-bold text-slate-900 dark:text-white mb-2">Engineers & Consultants</h3>
				<p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
					Site environmental checks, seasonal daylight exposure, and regulatory shadow verification.
				</p>
			</div>

			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
				<div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl mb-4 font-bold">🎓</div>
				<h3 class="font-bold text-slate-900 dark:text-white mb-2">Architecture Students</h3>
				<p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
					Clear, data-driven site studies and high-clarity thesis presentation boards (Academic discount available).
				</p>
			</div>

			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
				<div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl mb-4 font-bold">🏡</div>
				<h3 class="font-bold text-slate-900 dark:text-white mb-2">Property Owners</h3>
				<p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
					Verify sunlight impact from neighboring buildings, validate house extensions, and ensure compliance.
				</p>
			</div>
		</div>

		<div class="mt-6 p-4 rounded-xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-300">
			💡 <em>Note: Our work is strictly based on objective, site-based analysis and factual geometric drawings, not conceptual or artistic impressions.</em>
		</div>
	</section>

	<!-- WHAT WE PROVIDE (PACKAGES) -->
	<section class="mb-24">
		<div class="border-b border-slate-200 dark:border-slate-800 pb-3 mb-8">
			<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ SERVICE PACKAGES ]</span>
			<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">What We Provide</h2>
		</div>

		<div class="space-y-12">
			<!-- Package 1 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xl flex flex-col lg:flex-row gap-8 lg:gap-12 items-center">
				<div class="w-full lg:w-1/2 flex-shrink-0">
					<div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-inner aspect-video bg-black">
						<iframe 
							class="w-full h-full"
							src="https://www.youtube-nocookie.com/embed/H99ZyHeyzgg" 
							title="Site Analysis Video" 
							frameborder="0" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center">
					<h3 class="text-2xl font-black text-slate-900 dark:text-white mb-2">1. Site & Context Analysis Diagrams</h3>
					<p class="text-slate-600 dark:text-slate-300 text-sm mb-4">
						For architects, engineers, and students who need clear site analysis diagrams to support design development and presentations.
					</p>
					<ul class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-2 mb-6 list-disc list-inside">
						<li>Sun path and shadow analysis (seasonal / hourly).</li>
						<li>3D reconstruction of existing buildings for shadow verification.</li>
						<li>Seasonal prevailing wind direction data overlays.</li>
						<li>Deliverable in high-resolution PDF + SketchUp source model.</li>
					</ul>
					<div class="flex flex-wrap gap-3">
						<a href="https://www.fiverr.com/s/99DybaE" target="_blank" rel="noopener" class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs shadow-md transition-colors">
							👉 View Site Analysis Package on Fiverr
						</a>
						<a href="https://drive.google.com/file/d/1lFHrBjoEKD-7o_wtDjf58_h8BCqXwnv6/" target="_blank" rel="noopener" class="px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
							🗃 Download Sample Files
						</a>
					</div>
				</div>
			</div>

			<!-- Package 2 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xl flex flex-col lg:flex-row gap-8 lg:gap-12 items-center">
				<div class="w-full lg:w-1/2 flex-shrink-0">
					<div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-inner aspect-video bg-black">
						<iframe 
							class="w-full h-full"
							src="https://www.youtube-nocookie.com/embed/Iqnq-_WzxZY" 
							title="Shadow Analysis Video" 
							frameborder="0" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen
						></iframe>
					</div>
				</div>
				<div class="w-full lg:w-1/2 flex flex-col justify-center">
					<h3 class="text-2xl font-black text-slate-900 dark:text-white mb-2">2. Sun & Shadow Impact Analysis</h3>
					<p class="text-slate-600 dark:text-slate-300 text-sm mb-4">
						For shadow studies, sunlight verification, and neighboring impact checks between existing or proposed buildings.
					</p>
					<ul class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-2 mb-6 list-disc list-inside">
						<li>Sun path and shadow analysis (seasonal / hourly).</li>
						<li>3D reconstruction of existing buildings for shadow verification.</li>
						<li>Mutual shadow impact checks between neighboring properties.</li>
						<li>Comprehensive analytical PDF verification report.</li>
					</ul>
					<div class="flex flex-wrap gap-3">
						<a href="https://www.fiverr.com/s/m5GjQGb" target="_blank" rel="noopener" class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs shadow-md transition-colors">
							👉 View Shadow Analysis Package on Fiverr
						</a>
						<a href="https://drive.google.com/file/d/1IpG-AffarUWEORplsmTQkJhL3luif14Y/" target="_blank" rel="noopener" class="px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-xs hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
							🗃 Download Sample Files
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- HOW WE WORK & INPUTS -->
	<section class="mb-24 grid grid-cols-1 md:grid-cols-2 gap-8">
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 shadow-lg">
			<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ WORKFLOW ]</span>
			<h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-1 mb-6">How We Work</h2>
			<ol class="space-y-4 text-sm text-slate-700 dark:text-slate-300 font-medium">
				<li class="flex items-start gap-3">
					<span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center text-xs font-bold font-mono flex-shrink-0">1</span>
					<div>We review your site coordinates, project drawings, and goals.</div>
				</li>
				<li class="flex items-start gap-3">
					<span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center text-xs font-bold font-mono flex-shrink-0">2</span>
					<div>We set up accurate true North orientation and calibrated sun data in SketchUp.</div>
				</li>
				<li class="flex items-start gap-3">
					<span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center text-xs font-bold font-mono flex-shrink-0">3</span>
					<div>We produce clean, presentation-ready architectural diagrams.</div>
				</li>
				<li class="flex items-start gap-3">
					<span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center text-xs font-bold font-mono flex-shrink-0">4</span>
					<div>We deliver final PDF report files along with source SketchUp models.</div>
				</li>
			</ol>
		</div>

		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 shadow-lg">
			<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ REQUIREMENTS ]</span>
			<h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-1 mb-6">What You Need to Provide</h2>
			<ul class="space-y-3.5 text-sm text-slate-700 dark:text-slate-300 list-disc list-inside">
				<li><strong>Floor plans</strong> of all relevant levels.</li>
				<li><strong>Building elevations & sections</strong> (with dimensions or scale).</li>
				<li><strong>3D Model</strong> (SketchUp or OBJ/FBX) if available. If not, we can reconstruct the geometry from 2D drawings.</li>
				<li><em>Note:</em> We require architectural drawings. We cannot process projects provided only via Google Maps links without dimensions.</li>
			</ul>
		</div>
	</section>

	<!-- PRICING & ORDERING -->
	<section class="mb-16 text-center max-w-3xl mx-auto bg-gradient-to-b from-white to-slate-100 dark:from-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl">
		<span class="text-xs font-mono font-bold tracking-widest text-amber-500 uppercase">[ PRICING & ORDERING ]</span>
		<h2 class="text-3xl font-black text-slate-900 dark:text-white mt-2 mb-4">Project-Based Pricing — Starting from $50 USD</h2>
		<p class="text-slate-600 dark:text-slate-300 text-sm max-w-xl mx-auto mb-8">
			Typically includes 3 complete site analysis diagrams (Winter Solstice, Summer Solstice, and Equinox). Academic projects eligible for reduced rates.
		</p>
		<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
			<a href="https://www.fiverr.com/s/99DybaE" target="_blank" rel="noopener" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-sm shadow-lg shadow-amber-500/20 transition-all">
				👉 Order on Fiverr
			</a>
			<a href="https://www.fiverr.com/febhouse_com" target="_blank" rel="noopener" class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">
				💬 Message us on Fiverr
			</a>
		</div>
	</section>
</LandingLayout>
