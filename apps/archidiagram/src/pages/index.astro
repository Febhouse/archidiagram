---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Card from '../components/Card.astro';
import ToolsShowcase from '../components/ToolsShowcase.astro';
import HeroCoverSlider from '../components/HeroCoverSlider.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { SITE_DESCRIPTION, SITE_TITLE, isPublishablePost } from '../consts';
import { getCollection } from 'astro:content';

// ONLY publish posts that explicitly have tags and are not dedicated landing pages/redirects
const posts = (await getCollection('blog'))
	.filter(isPublishablePost)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`${SITE_TITLE} - Master Architectural Diagrams`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-amber-500/20 selection:text-amber-700 transition-colors duration-300">
		<Header />

		<main class="w-full">
			<!-- 🚀 HERO VIDEO COVER SLIDER SECTION (3 Major Categories: Tutorials, Free Downloads, Toolkits) -->
			<HeroCoverSlider />

			<!-- 🛠 3 CORE TOOLS SHOWCASE SECTION (The Most Popular Extension Packs) -->
			<ToolsShowcase />

			<!-- 📂 RESOURCES SECTION WITH HORIZONTAL FILTER TABS -->
			<section id="resources" class="py-20 w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 max-w-[1920px]">
				
				<!-- Subtle Community Badge -->
				<div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-8 bg-slate-100 dark:bg-slate-800/50 p-2 sm:p-3 rounded-2xl border border-slate-200 dark:border-slate-700/50 w-fit">
					<div class="flex -space-x-2 hidden sm:flex">
						<img class="w-8 h-8 rounded-full border-2 border-slate-100 dark:border-slate-800" src="https://ui-avatars.com/api/?name=Archi&background=F59E0B&color=fff" alt="Member" />
						<img class="w-8 h-8 rounded-full border-2 border-slate-100 dark:border-slate-800" src="https://ui-avatars.com/api/?name=Design&background=3B82F6&color=fff" alt="Member" />
						<img class="w-8 h-8 rounded-full border-2 border-slate-100 dark:border-slate-800" src="https://ui-avatars.com/api/?name=Creator&background=10B981&color=fff" alt="Member" />
					</div>
					<div class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 font-medium px-2 sm:px-0">
						Join <span class="font-bold text-slate-900 dark:text-white">60,000+</span> architects on
					</div>
					<div class="flex items-center gap-3 border-l border-slate-300 dark:border-slate-600 pl-3 sm:pl-4 pr-1 sm:pr-2">
						<a href="https://www.instagram.com/febhouse_com/" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-pink-600 transition-colors" title="Instagram 38.4K">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
						</a>
						<a href="https://www.tiktok.com/@febhouse" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-black dark:hover:text-white transition-colors" title="TikTok 29.8K">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.78-1.15 5.54-3.33 7.39-2.2 1.88-5.3 2.66-8.14 2.05-2.73-.56-5.02-2.38-6.05-4.97-1.04-2.58-.72-5.69.81-8.03 1.5-2.3 4.12-3.71 6.84-3.95v4.05c-1.72.15-3.33 1.13-4.14 2.63-.8 1.49-.78 3.32.06 4.79.82 1.46 2.45 2.37 4.13 2.35 1.7-.01 3.28-1.04 4.02-2.54.34-.69.51-1.46.52-2.23.03-4.8.01-9.61.02-14.41z"/></svg>
						</a>
					</div>
				</div>

				<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
					<div>
						<span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-amber-500/10 text-amber-800 dark:text-amber-400 border border-amber-500/20 mb-3">
							📚 TUTORIALS & RESOURCES
						</span>
						<h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
							Browse All Resources & Diagrams
						</h2>
					</div>
					<div class="relative w-full md:w-64 shrink-0">
						<input type="text" id="search-input" placeholder="Search resources..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-sm font-medium text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500/50 transition-shadow" />
						<svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
						</svg>
					</div>
				</div>

				<!-- HORIZONTAL FILTER TABS (Category & Software) -->
				<div class="space-y-4 mb-10">
					<!-- Category Filter Tabs -->
					<div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 pt-1 border-b border-slate-200 dark:border-slate-800" id="filter-tabs-container">
						<button data-category="ALL" class="tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm shrink-0 cursor-pointer">
							[ALL CATEGORIES]
						</button>
						<button data-category="tutorial" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 shrink-0 cursor-pointer">
							[WORKFLOW & TIPS]
						</button>
						<button data-category="sample project" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 shrink-0 cursor-pointer">
							[SAMPLE PROJECTS]
						</button>
						<button data-category="presentation template" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 shrink-0 cursor-pointer">
							[PRESENTATION & SITE ANALYSIS TEMPLATES]
						</button>
						<button data-category="other resources" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 shrink-0 cursor-pointer">
							[SKETCHUP EXTENSIONS]
						</button>
					</div>

					<!-- Software Filter Pills -->
					<div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 pt-1" id="software-filter-container">
						<span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 shrink-0 mr-1 hidden sm:inline">
							Software:
						</span>
						<button data-software="ALL" class="sw-filter-btn active inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-amber-500 text-slate-950 shadow-sm shrink-0 cursor-pointer border border-amber-500">
							<span>All Software</span>
						</button>
						<button data-software="sketchup" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/SketchUp-logo.svg" alt="SketchUp" class="w-3.5 h-3.5 object-contain" />
							<span>SketchUp</span>
						</button>
						<button data-software="sun diagram" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/SunDiagram-logo.svg?v=2" alt="Sun Diagram" class="w-3.5 h-3.5 object-contain" />
							<span>Sun Diagram</span>
						</button>
						<button data-software="dynamic symbols" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/dynamic-symbols-logo.svg" alt="Dynamic Symbols" class="w-3.5 h-3.5 object-contain" />
							<span>Dynamic Symbols</span>
						</button>
						<button data-software="shadow slice" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/Shadowslice-logo.svg" alt="Shadow Slice" class="w-3.5 h-3.5 object-contain" />
							<span>Shadow Slice</span>
						</button>
						<button data-software="photoshop" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/Adobe_Photoshop_CC_icon.svg" alt="Photoshop" class="w-3.5 h-3.5 object-contain" />
							<span>Photoshop</span>
						</button>
						<button data-software="canva" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/canva-icon.svg" alt="Canva" class="w-3.5 h-3.5 object-contain" />
							<span>Canva</span>
						</button>
						<button data-software="powerpoint" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/Microsoft_Office_PowerPoint_(2025–present).svg" alt="PowerPoint" class="w-3.5 h-3.5 object-contain" />
							<span>PowerPoint</span>
						</button>
						<button data-software="indesign" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/Adobe_InDesign_CC_icon.svg" alt="InDesign" class="w-3.5 h-3.5 object-contain" />
							<span>InDesign</span>
						</button>
						<button data-software="gemini" class="sw-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-transparent shrink-0 cursor-pointer">
							<img src="/images/LOGO/Gemini_logo_2025.svg" alt="Gemini" class="w-3.5 h-3.5 object-contain" />
							<span>Gemini</span>
						</button>
					</div>
				</div>

				<!-- POSTS GRID (Only published tagged posts) -->
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="posts-grid">
					{posts.map((post) => {
						const rawTags = post.data.tags;
						const tagValue = (Array.isArray(rawTags) ? rawTags.join(',') : (rawTags || "")).trim().toLowerCase();
						
						const rawSoftware = post.data.software || post.data.Software;
						const softwareValue = (Array.isArray(rawSoftware) ? rawSoftware.join(',') : (rawSoftware || "")).trim().toLowerCase();
						
						return (
							<div class="post-card-item" data-post-tag={tagValue} data-post-software={softwareValue} data-post-title={post.data.title.toLowerCase()} data-post-desc={(post.data.description || '').toLowerCase()} data-post-slug={post.id.toLowerCase()}>
								<Card 
									id={post.id}
									title={post.data.title}
									description={post.data.description}
									pubDate={post.data.pubDate}
									heroImage={post.data.heroImage}
									tags={post.data.tags}
									software={post.data.software || (post.data as any).Software}
									badge={(post.data as any).badge}
								/>
							</div>
						);
					})}
				</div>
			</section>

			<!-- ❓ TECHNICAL SUPPORT & FAQ ACCORDION (Show it Better "What would you like to know about us?") -->
			<FaqAccordion />
		</main>

		<Footer />

		<!-- Interactive Combined Filter Script (Category + Software) -->
		<script>
			const tabBtns = document.querySelectorAll('.tab-btn');
			const swBtns = document.querySelectorAll('.sw-filter-btn');
			const postItems = document.querySelectorAll('.post-card-item');
			const searchInput = document.getElementById('search-input') as HTMLInputElement;

			let activeCategory = 'all';
			let activeSoftware = 'all';
			let activeSearchQuery = '';

			function normalizeForSearch(str: string) {
				let normalized = str.toLowerCase().replace(/[-_.,\/\\:;!?'"()\[\]{}|]/g, ' ');
				// Aliases
				normalized = normalized.replace(/\bsample\b/g, 'example');
				normalized = normalized.replace(/\bplugin\b/g, 'extension');
				normalized = normalized.replace(/\bother resources\b/g, 'extension');
				return normalized;
			}

			function applyFilters() {
				// Update Category Tab UI
				tabBtns.forEach(b => {
					const cat = (b.getAttribute('data-category') || '').toLowerCase();
					if (cat === activeCategory) {
						b.classList.remove('bg-slate-100', 'dark:bg-slate-800/80', 'text-slate-600', 'dark:text-slate-300');
						b.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'shadow-sm');
					} else {
						b.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'shadow-sm');
						b.classList.add('bg-slate-100', 'dark:bg-slate-800/80', 'text-slate-600', 'dark:text-slate-300');
					}
				});

				// Update Software Tab UI
				swBtns.forEach(b => {
					const sw = (b.getAttribute('data-software') || '').toLowerCase();
					if (sw === activeSoftware) {
						b.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border-transparent');
						b.classList.add('bg-amber-500', 'text-slate-950', 'shadow-sm', 'border-amber-500');
					} else {
						b.classList.remove('bg-amber-500', 'text-slate-950', 'shadow-sm', 'border-amber-500');
						b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border-transparent');
					}
				});

				// Filter Post Items
				postItems.forEach(item => {
					const itemTag = (item.getAttribute('data-post-tag') || '').toLowerCase();
					const itemSw = (item.getAttribute('data-post-software') || '').toLowerCase();
					const itemTitle = item.getAttribute('data-post-title') || '';
					const itemDesc = item.getAttribute('data-post-desc') || '';
					const itemSlug = item.getAttribute('data-post-slug') || '';

					let matchSearch = true;
					if (activeSearchQuery !== '') {
						const searchWords = normalizeForSearch(activeSearchQuery).split(/\s+/).filter(w => w.length > 0);
						const fullContent = normalizeForSearch(`${itemTitle} ${itemDesc} ${itemSlug} ${itemTag}`);
						matchSearch = searchWords.every(word => fullContent.includes(word));
					}

					let matchCategory = false;
					if (activeCategory === 'all') {
						matchCategory = true;
					} else if (activeCategory === 'tutorial' && itemTag === 'tutorial') {
						matchCategory = true;
					} else if (activeCategory === 'sample project' && itemTag === 'sample project') {
						matchCategory = true;
					} else if (activeCategory === 'presentation template' && itemTag === 'presentation template') {
						matchCategory = true;
					} else if (activeCategory === 'other resources' && (itemTag === 'other resources' || itemTag.includes('resource') || itemTag.includes('extension'))) {
						matchCategory = true;
					}

					let matchSoftware = false;
					if (activeSoftware === 'all') {
						matchSoftware = true;
					} else if (itemSw.includes(activeSoftware)) {
						matchSoftware = true;
					}

					if (matchCategory && matchSoftware && matchSearch) {
						(item as HTMLElement).style.display = 'block';
					} else {
						(item as HTMLElement).style.display = 'none';
					}
				});
			}

			function handleCategoryLinkClick(category: string) {
				activeCategory = (category || 'all').toLowerCase();
				applyFilters();
				const resourcesEl = document.getElementById('resources');
				if (resourcesEl) {
					const headerOffset = 80;
					const elementPosition = resourcesEl.getBoundingClientRect().top;
					const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
					window.scrollTo({
						top: offsetPosition,
						behavior: 'smooth'
					});
				}
			}

			// Add click listeners to category tab buttons
			tabBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					activeCategory = (btn.getAttribute('data-category') || 'ALL').toLowerCase();
					applyFilters();
				});
			});

			// Add click listeners to software filter buttons
			swBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					activeSoftware = (btn.getAttribute('data-software') || 'ALL').toLowerCase();
					applyFilters();
				});
			});

			// Add input listener to search input
			if (searchInput) {
				searchInput.addEventListener('input', (e) => {
					activeSearchQuery = (e.target as HTMLInputElement).value.toLowerCase();
					applyFilters();
				});
			}

			// Add click listeners to all links targeting a category
			const categoryLinks = document.querySelectorAll('[data-category-target]');
			categoryLinks.forEach(link => {
				link.addEventListener('click', (e) => {
					const targetCat = link.getAttribute('data-category-target');
					if (targetCat && (window.location.pathname === '/' || window.location.pathname === '')) {
						e.preventDefault();
						handleCategoryLinkClick(targetCat);
					}
				});
			});

			// Check URL query parameters or hash on initial load
			const urlParams = new URLSearchParams(window.location.search);
			const catParam = urlParams.get('category');
			const swParam = urlParams.get('software');
			if (catParam) {
				activeCategory = catParam.toLowerCase();
			}
			if (swParam) {
				activeSoftware = swParam.toLowerCase();
			}
			if (catParam || swParam) {
				applyFilters();
			}
		</script>
	</body>
</html>
