---
interface ToolLink {
	text: string;
	subText?: string;
	icon?: string;
	url: string;
	primary?: boolean;
}

interface Tool {
	id: string;
	name: string;
	nameLink: string;
	description: string;
	features: string[];
	logoImg: string;
	previewImg?: string;
	links: ToolLink[];
}

const tools: Tool[] = [
	{
		id: "dynamic-symbols",
		name: "1. Dynamic Symbols",
		nameLink: "/dynamic-symbols/",
		description: "Dynamic Symbols is a SketchUp extension (plugin) that allows you to create animated symbols and switch between different states with just one click.",
		features: [
			"1. One-Click Symbol Change — Keep Position, Size & Rotation.",
			"2. One-Click Color Change – Keep Position & Orientation.",
			"3. Create Animation."
		],
		logoImg: "/images/LOGO/dynamic-symbols-logo.svg?v=3",
		previewImg: "/images/2026/01/DYNAMICSYMBOLS.gif",
		links: [
			{
				text: "Free Download",
				subText: "from Extension Warehouse",
				icon: "/images/LOGO/SketchUp-logo.svg",
				url: "https://extensions.sketchup.com/extension/21085584-a984-474d-8407-33087adec402/dynamic-symbols",
				primary: true
			},
			{
				text: "Learn about Dynamic Symbols",
				url: "/dynamic-symbols/",
				primary: false
			}
		]
	},
	{
		id: "sun-diagram",
		name: "2. Sun Diagram",
		nameLink: "/sun-diagram/",
		description: "Sun Diagram is a SketchUp extension (plugin) designed to create 3D Sun paths and analyze sunlight for architectural projects.",
		features: [
			"1. Create Sunpath.",
			"2. Shadow Analysis.",
			"3. Batch Export Shadows.",
			"4. Diagram Styles."
		],
		logoImg: "/images/LOGO/SunDiagram-logo.svg?v=2",
		previewImg: "/images/2026/01/SHADOWANALYSIS-DEC-CROPlogo.gif",
		links: [
			{
				text: "Free Download",
				subText: "from Extension Warehouse",
				icon: "/images/LOGO/SketchUp-logo.svg",
				url: "https://extensions.sketchup.com/extension/5aa1ab3d-36ff-4510-ae63-84f677a36f3a/sun-diagram",
				primary: true
			},
			{
				text: "Learn about Sun Diagram",
				url: "/sun-diagram/",
				primary: false
			}
		]
	},
	{
		id: "shadow-slice",
		name: "3. Shadow Slice",
		nameLink: "/shadow-slice/",
		description: "Interior Shadow & Section Tool for SketchUp. Cut away walls and roofs while keeping their natural shadows. The perfect tool for interior sunlight simulation.",
		features: [
			"1. 1-Click Slicing.",
			"2. Centralized Visual Dashboard.",
			"3. Smart Style Management."
		],
		logoImg: "/images/LOGO/Shadowslice-logo.svg",
		previewImg: "/images/2026/06/Feature02.gif",
		links: [
			{
				text: "Free Download",
				subText: "from Extension Warehouse",
				icon: "/images/LOGO/SketchUp-logo.svg",
				url: "https://extensions.sketchup.com/extension/e10f7017-931a-45a9-8e5d-d65df0926ddd/shadow-slice",
				primary: true
			},
			{
				text: "Learn about Shadow Slice",
				url: "/shadow-slice/",
				primary: false
			}
		]
	}
];
---

<section id="tools" class="py-20 bg-transparent text-slate-900 dark:text-white relative overflow-hidden transition-colors duration-300">
	<div class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 max-w-[1920px] relative z-10">
		<div class="text-center max-w-3xl mx-auto mb-16">
			<span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 mb-4">
				⚡ RECOMMENDED WORKFLOWS & TOOLS
			</span>
			<h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight text-slate-900 dark:text-white mb-4">
				Essential Workflows & Tools
			</h2>
			<p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg font-light leading-relaxed mb-8">
				Accelerate your environmental analysis, shadow sectioning, and diagram presentation in SketchUp.
			</p>
			<a href="https://extensions.sketchup.com/search/?q=febhouse" target="_blank" rel="noopener" class="inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-5 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 hover:border-amber-500/50 hover:shadow-md transition-all group shadow-sm">
				<img src="/images/LOGO/SketchUp-logo.svg" alt="SketchUp" class="w-5 h-5 object-contain drop-shadow-sm group-hover:scale-110 transition-transform" />
				<div class="flex items-center gap-1 sm:gap-1.5 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-1.5 sm:px-2 py-0.5 rounded-md text-[10px] sm:text-xs font-bold border border-blue-200 dark:border-blue-800/50">
					<svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
					Verified SketchUp Developer
				</div>
				<span class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
					Trusted by <span class="text-amber-600 dark:text-amber-400">45,000+</span> architects
				</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-amber-500 group-hover:translate-x-1 transition-transform ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</a>
		</div>

		<!-- 3 Core Tools Grid with Official Extension Logos -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{tools.map((tool) => (
				<div class="group relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-500/60 rounded-[8px] p-[10px] overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 shadow-sm hover:shadow-xl">
					
					<!-- GIF Animation Preview -->
					{tool.previewImg && (
						<div class="w-full aspect-[4/3] sm:aspect-video md:aspect-[4/3] lg:aspect-video bg-slate-100 dark:bg-slate-900 relative overflow-hidden rounded-[8px]">
							<img src={tool.previewImg} alt={`${tool.name} function preview`} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out rounded-[8px]" style="border-radius: 8px !important; box-shadow: none !important; border: none !important;" />
						</div>
					)}

					<div class="p-6 md:p-8 flex flex-col flex-grow">
						<!-- Title & Logo Row -->
						<div class="flex items-center gap-4 mb-5">
							<div class="w-12 h-12 shrink-0 flex items-center justify-center">
								<img src={tool.logoImg} alt={`${tool.name} Official Logo`} class="w-full h-full object-contain" />
							</div>
							<h3 class="m-0 p-0 leading-none">
								<a href={tool.nameLink} target="_blank" rel="noopener" class="text-xl lg:text-2xl font-bold text-slate-900 dark:text-white hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
									{tool.name}
								</a>
							</h3>
						</div>

						<p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-6">
							{tool.description}
						</p>

						<!-- Feature List -->
						<ul class="space-y-2.5 mb-8">
							{tool.features.map(feature => (
								<li class="flex items-start gap-2 text-xs text-slate-600 dark:text-slate-300 font-medium">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
									</svg>
									<span>{feature}</span>
								</li>
							))}
						</ul>
					</div>

					<div class="px-6 pb-6 md:px-8 md:pb-8 pt-2 flex flex-col gap-3">
						<!-- Button CTAs -->
						{tool.links.map(link => (
							<a href={link.url} target="_blank" rel="noopener" class={`w-full py-2.5 px-4 rounded-xl text-[12px] font-bold transition-all flex items-center justify-center gap-2.5 shadow-sm active:scale-[0.98] ${link.primary ? 'text-slate-950 bg-amber-400 hover:bg-amber-300 group-hover:shadow-md' : 'text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700'}`}>
								{link.icon && <img src={link.icon} alt="" class="w-5 h-5 object-contain" />}
								<div class="flex flex-col items-center sm:items-start text-center sm:text-left leading-tight">
									<span class="uppercase tracking-wider">{link.text}</span>
									{link.subText && <span class="text-[10px] font-semibold opacity-75 normal-case tracking-normal">{link.subText}</span>}
								</div>
								{link.primary && !link.subText && (
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
									</svg>
								)}
							</a>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>
