---
import FormattedDate from './FormattedDate.astro';

interface Props {
	id: string;
	title: string;
	description?: string;
	pubDate: Date;
	heroImage?: string;
	tags?: string;
	category?: string;
	software?: string | string[];
}

const { id, title, description, pubDate, heroImage, tags, category, software } = Astro.props;

// Determine clean display label from frontmatter tags or fallback
let displayCategory = category || "TUTORIAL & TIPS";
const tagRaw = Array.isArray(tags) ? tags.join(' ') : (tags || "");
const tagStr = tagRaw.toLowerCase();

if (tagStr.includes("sample project") || tagStr.includes("sample")) {
	displayCategory = "SAMPLE PROJECTS";
} else if (tagStr.includes("presentation template") || tagStr.includes("template")) {
	displayCategory = "PRESENTATION TEMPLATES";
} else if (tagStr.includes("tutorial")) {
	displayCategory = "TUTORIAL & TIPS";
} else if (tagStr.includes("other resources")) {
	displayCategory = "SKETCHUP EXTENSIONS";
}

// Clean original root-level SEO slug
const cleanSlug = id.replace(/^\d{4}-\d{2}-\d{2}-/, '');

const cleanDescription = (description || '')
	.replace(/^[\s\-]+/, '')
	.replace(/\\n/g, ' ')
	.trim();

// Parse Software list for badge icons
const softwareRaw = software || '';
const softwareList = Array.isArray(softwareRaw) 
	? softwareRaw 
	: (typeof softwareRaw === 'string' && softwareRaw.trim().length > 0)
		? softwareRaw.split(',').map(s => s.trim()).filter(Boolean)
		: [];

function getSoftwareBadge(sw: string) {
	const name = sw.toLowerCase();
	if (name.includes('sketchup')) {
		return { label: sw, logo: '/images/LOGO/SketchUp-logo.svg', class: 'bg-red-500/10 text-red-700 dark:text-red-300 border-red-500/20' };
	} else if (name.includes('sun diagram')) {
		return { label: sw, logo: '/images/LOGO/SunDiagram-logo.svg', class: 'bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-500/20' };
	} else if (name.includes('dynamic symbols')) {
		return { label: sw, logo: '/images/LOGO/dynamic-symbols-logo.svg', class: 'bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 border-indigo-500/20' };
	} else if (name.includes('shadow slice')) {
		return { label: sw, logo: '/images/LOGO/Shadowslice-logo.svg', class: 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border-cyan-500/20' };
	} else if (name.includes('photoshop')) {
		return { label: sw, logo: '/images/LOGO/Adobe_Photoshop_CC_icon.svg', class: 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/20' };
	} else if (name.includes('canva')) {
		return { label: sw, logo: '/images/LOGO/canva-icon.svg', class: 'bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/20' };
	} else if (name.includes('powerpoint')) {
		return { label: sw, logo: '/images/LOGO/Microsoft_Office_PowerPoint_(2025–present).svg', class: 'bg-orange-500/10 text-orange-700 dark:text-orange-300 border-orange-500/20' };
	} else if (name.includes('indesign')) {
		return { label: sw, logo: '/images/LOGO/Adobe_InDesign_CC_icon.svg', class: 'bg-pink-500/10 text-pink-700 dark:text-pink-300 border-pink-500/20' };
	} else if (name.includes('rwind')) {
		return { label: sw, logo: '/images/LOGO/Rwind-logo.svg', class: 'bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/20' };
	} else if (name.includes('gemini')) {
		return { label: sw, logo: '/images/LOGO/Gemini_logo_2025.svg', class: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20' };
	}
	return { label: sw, logo: null, class: 'bg-slate-500/10 text-slate-700 dark:text-slate-300 border-slate-500/20' };
}
---

<article class="group relative bg-white dark:bg-slate-900 rounded-[8px] border border-slate-200 dark:border-slate-800 p-[10px] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">
	<a href={`/${cleanSlug}/`} target="_blank" rel="noopener" class="flex flex-col h-full">
		<div class="relative w-full aspect-[16/9] overflow-hidden rounded-[8px] bg-slate-100 dark:bg-slate-800">
			{heroImage ? (
				<img 
					src={heroImage} 
					alt={title} 
					loading="lazy"
					decoding="async"
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out rounded-[8px]"
					style="border-radius: 8px !important; box-shadow: none !important; border: none !important;"
					onerror="this.onerror=null; this.src='/images/2025/01/3D-Symbol-01.jpg';"
				/>
			) : (
				<div class="w-full h-full flex items-center justify-center text-slate-400 text-xs bg-slate-100 dark:bg-slate-800 font-mono rounded-[8px]">
					Archidiagram Resource
				</div>
			)}
			
			<div class="absolute top-3 left-3 bg-slate-900/85 backdrop-blur-md text-amber-400 text-[10px] font-mono font-bold tracking-wider px-2.5 py-1 rounded-full border border-slate-700/60 uppercase">
				{displayCategory}
			</div>
		</div>

		<div class="p-4 sm:p-5 flex flex-col flex-grow">
			<p class="text-[11px] text-slate-400 mb-2 font-mono font-semibold tracking-wide uppercase flex items-center gap-1.5">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
				</svg>
				<FormattedDate date={pubDate} />
			</p>

			<h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2.5 group-hover:text-amber-500 transition-colors leading-snug line-clamp-2">
				{title}
			</h3>

			{cleanDescription && (
				<p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm line-clamp-2 leading-relaxed mb-3.5">
					{cleanDescription}
				</p>
			)}

			{softwareList.length > 0 && (
				<div class="flex flex-wrap gap-1.5 mb-3.5">
					{softwareList.map(sw => {
						const badge = getSoftwareBadge(sw);
						return (
							<span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-mono font-bold tracking-tight border ${badge.class}`}>
								{badge.logo && (
									<img src={badge.logo} alt={badge.label} class="w-3.5 h-3.5 shrink-0 object-contain" />
								)}
								<span>{badge.label}</span>
							</span>
						);
					})}
				</div>
			)}

			<div class="mt-auto pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-bold text-amber-600 dark:text-amber-400 group-hover:text-amber-500 uppercase tracking-wider">
				<span>Read Guide & Download</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</div>
		</div>
	</a>
</article>
