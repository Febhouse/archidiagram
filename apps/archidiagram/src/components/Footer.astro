---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 py-12 sm:py-16 transition-colors duration-300">
	<div class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 max-w-[1920px]">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
			<!-- Brand Info with Febhouse Logo -->
			<div class="md:col-span-2 space-y-4">
				<div class="flex items-center gap-3">
					<img 
						src="/images/2026/05/LOGO_FEBHOUSE1.svg" 
						alt="Febhouse Logo" 
						class="w-9 h-9 object-contain"
						onerror="this.onerror=null; this.src='/images/2025/03/FEBHOUSE-LOGO600x600.png';"
					/>
					<span class="text-xl font-black tracking-tight text-white uppercase">
						{SITE_TITLE}
					</span>
				</div>
				<p class="text-slate-400 text-sm leading-relaxed max-w-sm">
					Architectural diagram resources, free tutorials, SketchUp extensions, 3D dynamic symbols, and presentation templates for architects and design students worldwide.
				</p>
			</div>

			<!-- Core Extensions -->
			<div class="space-y-3">
				<h4 class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest">
					3 Core Extensions
				</h4>
				<ul class="space-y-2 text-sm">
					<li><a href="#tools" class="hover:text-white transition-colors">Sun Diagram</a></li>
					<li><a href="#tools" class="hover:text-white transition-colors">Dynamic Symbols</a></li>
					<li><a href="#tools" class="hover:text-white transition-colors">Shadow Slice</a></li>
				</ul>
			</div>

			<!-- Quick Links -->
			<div class="space-y-3">
				<h4 class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest">
					Resources & Legal
				</h4>
				<ul class="space-y-2 text-sm">
					<li><a href="#resources" class="hover:text-white transition-colors">Tutorials & Workflows</a></li>
					<li><a href="#faq" class="hover:text-white transition-colors">FAQ & Technical Support</a></li>
					<li><a href="https://febhouse.com/privacy-policy/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Privacy Policy</a></li>
					<li><a href="https://febhouse.com/terms-of-use/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Terms of Use</a></li>
				</ul>
			</div>
		</div>

		<div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 gap-4">
			<p>&copy; {today.getFullYear()} {SITE_TITLE}. Developed by Febhouse. All rights reserved.</p>
			<div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
				<a href="https://febhouse.com/privacy-policy/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Privacy Policy</a>
				<a href="https://febhouse.com/terms-of-use/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Terms of Use</a>
				<a href="https://febhouse.com/refund-policy/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Refund Policy</a>
				<a href="https://febhouse.com/legal-notice/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Legal Notice</a>
				<a href="#tools" class="text-amber-400 hover:underline font-bold ml-2">Back to top ↑</a>
			</div>
		</div>
	</div>
</footer>
