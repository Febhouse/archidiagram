---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`Contact - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-amber-500/20 selection:text-amber-700 transition-colors duration-300">
		<Header />

		<main class="w-full flex flex-col items-center">
			<section class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 py-16 md:py-24 flex flex-col items-start text-left space-y-12 max-w-[1920px]">
				
				<div class="w-full">
					<h1 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-6">
						Contact Febhouse | Architecture + Tech Studio
					</h1>
					
					<p class="text-slate-600 dark:text-slate-300 mb-6">
						Connect with Febhouse for collaborations or software and design inquiries.
					</p>

					<p class="text-slate-600 dark:text-slate-300 mb-6">
						We'd love to hear from you — whether it's collaboration, feedback, or just to say hi.
					</p>

					<div class="mb-8">
						<p class="font-bold text-slate-900 dark:text-white mb-2">Let's connect.</p>
						<p class="text-slate-600 dark:text-slate-300 mb-6">We're open to collaboration, feedback, and creative exchange.</p>

						<ul class="space-y-3 text-slate-600 dark:text-slate-300">
							<li class="flex items-center gap-2">
								<span>📧</span>
								<strong><a href="mailto:info@febhouse.com" class="hover:text-amber-500 transition-colors">info@febhouse.com</a></strong>
							</li>
							<li class="flex items-center gap-2">
								<span>📷</span>
								<a href="https://www.instagram.com/febhouse_com" target="_blank" rel="noopener noreferrer" class="hover:text-amber-500 transition-colors">Instagram @febhouse_com</a>
							</li>
							<li class="flex items-center gap-2">
								<span>▶️</span>
								<strong>YouTube:</strong> <a href="https://www.youtube.com/@febhouse_com" target="_blank" rel="noopener noreferrer" class="hover:text-amber-500 transition-colors">@Febhouse_com</a>
							</li>
							<li class="flex items-center gap-2">
								<span>📍</span>
								<strong>Hanoi, Vietnam</strong>
							</li>
						</ul>
					</div>

					<div class="w-full h-[400px] rounded-[8px] overflow-hidden border border-slate-200 dark:border-slate-800 shadow-sm">
						<iframe 
							aria-label="hyundai hillstate - ha cau- ha dong" 
							loading="lazy" 
							src="https://maps.google.com/maps?q=hyundai%20hillstate%20-%20ha%20cau-%20ha%20dong&t=m&z=14&output=embed&iwloc=near" 
							title="hyundai hillstate - ha cau- ha dong"
							class="w-full h-full border-0"
						></iframe>
					</div>

				</div>
				
			</section>
		</main>

		<Footer />
	</body>
</html>
