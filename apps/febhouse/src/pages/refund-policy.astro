---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Content as RefundPolicyContent } from '../data/refund-policy.md';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`Refund Policy - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style is:global>
			.markdown-content img { border-radius: 8px !important; box-shadow: none !important; border: none !important; margin-top: 2rem; margin-bottom: 2rem; max-width: 100%; height: auto; }
			.markdown-content h1, .markdown-content h2, .markdown-content h3 { font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; }
			.markdown-content h1 { font-size: 2.25rem; font-weight: 900; margin-top: 0; }
			.markdown-content h2 { font-size: 1.5rem; }
			.markdown-content h3 { font-size: 1.25rem; }
			.markdown-content a { color: #d97706; font-weight: 700; }
			.markdown-content a:hover { text-decoration: underline; }
			.dark .markdown-content a { color: #fbbf24; }
			.markdown-content p, .markdown-content li { margin-bottom: 1rem; line-height: 1.75; }
			.markdown-content ul { list-style-type: disc; margin-left: 1.5rem; margin-bottom: 1rem; }
		</style>
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-amber-500/20 selection:text-amber-700 transition-colors duration-300">
		<Header />
		<main class="w-full flex flex-col items-center">
			<section class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 py-16 md:py-24 text-left markdown-content max-w-[1920px]">
				<RefundPolicyContent />
			</section>
		</main>
		<Footer />
	</body>
</html>
