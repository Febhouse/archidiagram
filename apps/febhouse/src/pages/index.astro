---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={`${SITE_TITLE} - Architecture Tools and Design Studio`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-amber-500/20 selection:text-amber-700 transition-colors duration-300">
		<Header />

		<main class="w-full flex flex-col items-center">
			<!-- HERO SECTION -->
			<section class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 py-16 md:py-24 flex flex-col items-start text-left max-w-[1920px]">
				<h1 class="text-3xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-6">
					Architecture Tools And Design Studio
				</h1>
				<p class="text-base md:text-lg text-slate-600 dark:text-slate-300 mb-4 max-w-4xl">
					Febhouse is an <strong>architecture and technology studio</strong> that designs architectural projects and develops <strong>professional SketchUp extensions</strong> used by architects worldwide.
				</p>
				<p class="text-base md:text-lg text-slate-600 dark:text-slate-300 mb-8 max-w-4xl">
					We help architects <strong>visualize, analyze sunlight, and communicate design ideas more clearly.</strong>
				</p>
				<a href="/architecture-projects/" class="inline-flex items-center justify-center px-6 py-3 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm">
					Explore Our Work
				</a>
			</section>

			<!-- WHAT WE DO SECTION -->
			<section class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 py-12 flex flex-col items-start max-w-[1920px]">
				<h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-8 tracking-tight">
					What We Do - Design And Technology, Combined
				</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
					<!-- Card 1 -->
					<div class="flex flex-col bg-white dark:bg-slate-900 rounded-[8px] border border-slate-200 dark:border-slate-800 overflow-hidden">
						<div class="p-5 font-bold text-lg border-b border-slate-100 dark:border-slate-800 text-slate-900 dark:text-white">Architecture & Landscape Design</div>
						<div class="w-full aspect-[9/16] bg-slate-100 dark:bg-slate-800 relative p-0 border-0 overflow-hidden">
							<iframe 
								class="absolute inset-0 w-full h-full object-cover rounded-[8px]" 
								src="https://www.youtube.com/embed/yILCdMfaE1I?autoplay=1&mute=1&loop=1&playlist=yILCdMfaE1I&controls=0&modestbranding=1&rel=0" 
								title="Architecture & Landscape Design"
								frameborder="0" 
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
								allowfullscreen
								style="border-radius: 8px !important; pointer-events: none;"
							></iframe>
						</div>
						<div class="p-6 flex-grow flex flex-col justify-between">
							<p class="text-sm text-slate-600 dark:text-slate-300 mb-6">
								We <strong>design</strong> architectural and landscape projects that respond to climate, context, and environmental conditions — combining functionality, sustainability, and clear design thinking.
							</p>
							<a href="/architecture-projects/" class="w-full text-center px-4 py-2 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-sm text-slate-900 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shadow-sm">
								View Projects
							</a>
						</div>
					</div>
					
					<!-- Card 2 -->
					<div class="flex flex-col bg-white dark:bg-slate-900 rounded-[8px] border border-slate-200 dark:border-slate-800 overflow-hidden">
						<div class="p-5 font-bold text-lg border-b border-slate-100 dark:border-slate-800 text-slate-900 dark:text-white">Architecture Tools</div>
						<div class="w-full aspect-[9/16] bg-slate-100 dark:bg-slate-800 relative p-0 border-0 overflow-hidden">
							<iframe 
								class="absolute inset-0 w-full h-full object-cover rounded-[8px]" 
								src="https://www.youtube.com/embed/LILJFNDNSKU?autoplay=1&mute=1&loop=1&playlist=LILJFNDNSKU&controls=0&modestbranding=1&rel=0" 
								title="Architecture Tools"
								frameborder="0" 
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
								allowfullscreen
								style="border-radius: 8px !important; pointer-events: none;"
							></iframe>
						</div>
						<div class="p-6 flex-grow flex flex-col justify-between">
							<p class="text-sm text-slate-600 dark:text-slate-300 mb-6">
								We develop <strong>professional SketchUp extensions</strong> that help architects <strong>visualize sunlight, automate diagrams, and improve workflows.</strong><br/><br/>
								Our tools — including <strong>Sun Diagram, Dynamic Symbols, and Shadow Slice</strong> — are published on the <a href="https://extensions.sketchup.com/developer/582b09fa-9fe2-4248-b9e8-80dc7af69a76" class="text-amber-600 hover:underline">SketchUp Extension Warehouse</a> and used by <strong>architects, designers, and students worldwide.</strong>
							</p>
							<a href="/architecture-tools/" class="w-full text-center px-4 py-2 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-sm text-slate-900 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shadow-sm">
								Get Architecture Tools
							</a>
						</div>
					</div>
					
					<!-- Card 3 -->
					<div class="flex flex-col bg-white dark:bg-slate-900 rounded-[8px] border border-slate-200 dark:border-slate-800 overflow-hidden">
						<div class="p-5 font-bold text-lg border-b border-slate-100 dark:border-slate-800 text-slate-900 dark:text-white">Resources For Architects</div>
						<div class="w-full aspect-[9/16] bg-slate-100 dark:bg-slate-800 relative p-0 border-0 overflow-hidden">
							<iframe 
								class="absolute inset-0 w-full h-full object-cover rounded-[8px]" 
								src="https://www.youtube.com/embed/qWwVaH2sASM?autoplay=1&mute=1&loop=1&playlist=qWwVaH2sASM&controls=0&modestbranding=1&rel=0" 
								title="Resources For Architects"
								frameborder="0" 
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
								allowfullscreen
								style="border-radius: 8px !important; pointer-events: none;"
							></iframe>
						</div>
						<div class="p-6 flex-grow flex flex-col justify-between">
							<p class="text-sm text-slate-600 dark:text-slate-300 mb-6">
								We <strong>share</strong> tutorials, templates, and professional diagram resources through <strong>ArchiDiagram.com</strong> — helping architects work faster and present ideas more clearly.
							</p>
							<a href="https://archidiagram.com/" target="_blank" rel="noopener noreferrer" class="w-full text-center px-4 py-2 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-sm text-slate-900 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shadow-sm">
								Visit ArchiDiagram
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- ABOUT FEBHOUSE -->
			<section class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 py-12 flex flex-col items-start max-w-[1920px]">
				<h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-6 tracking-tight">
					About Febhouse
				</h2>
				<div class="text-sm md:text-base text-slate-600 dark:text-slate-300 space-y-3 max-w-4xl">
					<p>Febhouse is an independent Architecture & Technology Studio based in Hanoi.</p>
					<p>We work at the intersection of design and innovation, combining architectural expertise with software development to create tools, visual systems, and workflows that enhance how architects design and present.</p>
					<p><a href="https://extensions.sketchup.com/developer/582b09fa-9fe2-4248-b9e8-80dc7af69a76" class="font-bold text-slate-900 dark:text-white underline hover:text-amber-500 transition-colors">Official SketchUp Extension Vendor on SketchUp Extension Warehouse</a></p>
					<p>Our mission is to make architectural design smarter, faster, and more sustainable.</p>
				</div>
			</section>

			<!-- GET IN TOUCH -->
			<section class="w-full mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 py-12 mb-12 flex flex-col items-start max-w-[1920px]">
				<h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white mb-6 tracking-tight">
					Get In Touch
				</h2>
				<div class="text-sm md:text-base text-slate-600 dark:text-slate-300 mb-8 max-w-4xl space-y-2">
					<p>Have a project, collaboration, or question?</p>
					<p>Febhouse works with architects, studios, educators, and design professionals worldwide.</p>
				</div>
				<div class="flex flex-wrap gap-4">
					<a href="https://archidiagram.com/" target="_blank" rel="noopener noreferrer" class="px-6 py-2.5 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-sm text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm">
						Visit ArchiDiagram
					</a>
					<a href="/architecture-projects/" class="px-6 py-2.5 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-sm text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm">
						Explore Our Work
					</a>
					<a href="/architecture-tools/" class="px-6 py-2.5 border border-slate-300 dark:border-slate-700 rounded-full font-bold text-sm text-slate-900 dark:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors shadow-sm">
						Get Architecture Tools
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
